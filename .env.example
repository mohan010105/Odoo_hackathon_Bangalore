# ---------------------------------------------------------------------------
# Dayflow HRMS — environment template
# Copy to .env and fill in the values for your own backend project.
#   cp .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# --- Browser-safe (exposed to the client bundle) ---------------------------
# Base URL of your Supabase project, e.g. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Publishable / anon key of that project (safe to ship; RLS protects the data)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Alias for VITE_SUPABASE_PUBLISHABLE_KEY:
VITE_SUPABASE_ANON_KEY=
# Project reference id (used for storage/debug labels)
VITE_SUPABASE_PROJECT_ID=

# --- Server-only (never prefix these with VITE_) ---------------------------
# Same Supabase project, read by server functions / SSR
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PROJECT_ID=
# Required only by privileged server code (employee provisioning, admin tasks)
SUPABASE_SERVICE_ROLE_KEY=

# Odoo integration — SERVER ONLY. These must never become VITE_* variables.
ODOO_BASE_URL=
ODOO_DATABASE=
ODOO_USERNAME=
ODOO_API_KEY=

# Optional: shared secret for scheduled/cron endpoints
LOVABLE_CRON_SECRET=
